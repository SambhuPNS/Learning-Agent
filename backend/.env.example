# Copy to .env. Leave GOOGLE_CLOUD_PROJECT empty to run the scripted mock tutor.
# Enable the Vertex AI API and run `gcloud auth application-default login` locally.
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated Vertex AI model IDs available in your project/location.
GEMINI_FALLBACK_MODELS=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Achird
# Optional: require this code when someone registers as a teacher.
TEACHER_INVITE_CODE=
# Set to true only after creating Firestore and running `gcloud auth application-default login` locally.
FIRESTORE_ENABLED=false
