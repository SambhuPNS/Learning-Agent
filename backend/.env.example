# Copy to .env and paste your key. Leave empty to run the scripted mock tutor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Achird
# Optional: require this code when someone registers as a teacher.
TEACHER_INVITE_CODE=
# Set to true only after creating Firestore and running `gcloud auth application-default login` locally.
FIRESTORE_ENABLED=false
# Required for local Firestore use when Application Default Credentials has no project configured.
GOOGLE_CLOUD_PROJECT=
